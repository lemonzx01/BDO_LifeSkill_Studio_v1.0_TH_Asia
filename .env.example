# Postgres connection string. Neon URLs use the Neon HTTP driver, anything else
# (Supabase, Railway, self-hosted...) uses postgres.js. POSTGRES_URL is accepted
# too (the name Vercel's Neon/Supabase marketplace integrations inject).
# Leave unset to use the embedded PGlite database under .data/pglite locally.
# Supabase: Connect -> ORMs -> Drizzle -> "Transaction pooler" string (port 6543)
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Protects /api/cron/market (Vercel sends it as a bearer token)
# CRON_SECRET=change-me
